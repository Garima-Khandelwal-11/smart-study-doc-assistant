# Postgres connection string (pgvector-backed store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_assistant

# Groq API key used by app/services/llm.py
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend
# Defaults to http://localhost:5173 if not set
ALLOWED_ORIGINS=http://localhost:5173
