#!/bin/sh
# Reject commits whose message credits Claude/Anthropic as a co-author.
# Installed via: git config core.hooksPath .githooks

msg_file="$1"

if grep -iE '^(co-authored-by:.*(claude|anthropic)|claude-session:)' "$msg_file" > /dev/null; then
    echo "error: commit message contains a Claude/Anthropic co-author trailer." >&2
    echo "Remove the Co-Authored-By/Claude-Session line(s) and commit again." >&2
    exit 1
fi

exit 0
